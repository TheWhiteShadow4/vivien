# Vivien Server Konfiguration
mode = "hosted" # Wir entwickeln mit hosted, weil dabei der Browser nicht geöffnet wird

# Das Git-Repository, auf dem Vivien arbeiten soll
git.remote = "origin"
git.branch = "master"
git.user = <Git_USER>
git.token = <GIT_TOKEN>
git.resolve = "ours"
repo_path = "./game-repo"
engine_plugin = "Unity"

[server]
host = "localhost"
port = 8080
security = "lax"
users = [ "Anna", "Fufu" ]
password = "*****"
# Erlaubte Upload Formate (Optional)
formats = "png,jpg,jpeg,tif,tiff,tga,txt,md,json,yaml,wav,mp3,acc,ogg,fbx,glb,gltf,obj,mtl"

[preview]
output = "jpg"
compression = 0.5

[views.admin]
excludes = [ ".meta" ]

[views.artist]
root = "Assets"
includes = [ "*.png", "*.jpg", "*.tga", "*.tif", "*.svg", "*.md", "*.txt", "*.json", "*.yaml", "*.fbx", "*.obj", "*.gltf", "*.glb", "*.wav", "*.mp3", "*.ogg", "*.aac" ]
excludes = [ ".idea/", ".git/", ".meta" ]
